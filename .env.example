# =========================================================================
# ⚡ AUTOMAGIK HIVE - APPLICATION ENVIRONMENT CONFIGURATION
# =========================================================================
#
# NOTES:
# - This is the application environment template. Copy to .env and fill in your values.
# - This file contains application-level configuration only
# - Docker containers inherit from this .env and override specific values in docker-compose.yml
# - DO NOT commit the .env file to version control.
#
# STATUS LEGEND:
# ✅ = Fully functional
# ⚠️ = Defined but not yet implemented
# 🔧 = Partial (needs work)
#
# =========================================================================

# -------------------------------------------------------------------------
# CORE APPLICATION SETTINGS
# -------------------------------------------------------------------------
# App Environment (development, staging, production) ✅
HIVE_ENVIRONMENT=development

# ⚠️ NOT IMPLEMENTED: Logging Level (DEBUG, INFO, WARNING, ERROR)
# HIVE_LOG_LEVEL=INFO

# ⚠️ NOT IMPLEMENTED: Agno uses AGNO_DEBUG (true/false), not AGNO_LOG_LEVEL
# AGNO_LOG_LEVEL=WARNING

# ⚠️ NOT IMPLEMENTED: Log directory for file output
# HIVE_LOG_DIR=./logs

# -------------------------------------------------------------------------
# SERVER & API (for local development)
# -------------------------------------------------------------------------
# ⚠️ NOT IMPLEMENTED: Server bind address (CLI uses hardcoded 0.0.0.0)
# HIVE_API_HOST=0.0.0.0

# Server port ✅
HIVE_API_PORT=8886

# ⚠️ NOT IMPLEMENTED: Worker processes (uvicorn always runs single worker)
# HIVE_API_WORKERS=1

# -------------------------------------------------------------------------
# DATABASE (for local development)
# -------------------------------------------------------------------------
# 🔧 Database backend type (auto-generated during install, used by Makefile only)
# Options: sqlite, postgresql
# - sqlite: DEVELOPMENT/TESTING ONLY - CANNOT persist agent sessions/memory (use for CI/CD only)
# - postgresql: Full PostgreSQL with Docker (requires Docker installation)
HIVE_DATABASE_BACKEND=sqlite

# Connection URL for local development ✅
# ⚠️ SQLite WARNING: Agents CANNOT save sessions or remember users between requests
# Use ONLY for CI/CD testing or stateless scenarios.
# SQLite example:
HIVE_DATABASE_URL=sqlite:///./data/automagik_hive.db

# PostgreSQL example (production - requires Docker):
# HIVE_DATABASE_URL=postgresql+psycopg://hive_user:your-secure-password-here@localhost:5532/hive

# ⚠️ NOT IMPLEMENTED: Data directory for persistent storage
# HIVE_DATA_DIR=./data


# -------------------------------------------------------------------------
# AI PROVIDER KEYS & DEFAULTS
# -------------------------------------------------------------------------
# ⚠️ NOT IMPLEMENTED: Fallback model (agents specify models in YAML configs)
# HIVE_DEFAULT_MODEL=gpt-5

# AI Provider API Keys (at least one required) ✅
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
# ⚠️ NOT IMPLEMENTED: Grok (x.AI) integration not yet available
# GROK_API_KEY=your-grok-api-key-here
GROQ_API_KEY=your-groq-api-key-here
COHERE_API_KEY=your-cohere-api-key-here

# -------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# -------------------------------------------------------------------------
# ⚠️ NOT IMPLEMENTED: Master API key (no auth middleware exists)
# HIVE_API_KEY=your-hive-api-key-here

# Allowed CORS origins (comma-separated list) ✅
HIVE_CORS_ORIGINS=http://localhost:3000,http://localhost:8886

# ⚠️ NOT IMPLEMENTED: Authentication controls (no auth system exists)
# HIVE_AUTH_DISABLED=true

# =========================================================================
# 🔧 NOTIFICATIONS & INTEGRATIONS
# =========================================================================
# ⚠️ NOT IMPLEMENTED: WhatsApp alerts via Evolution MCP
# HIVE_WHATSAPP_NOTIFICATIONS_ENABLED=true
# WHATSAPP_NOTIFICATION_GROUP=your-whatsapp-group-id@g.us

# ⚠️ NOT IMPLEMENTED: LangWatch metrics tracking
# LANGWATCH_API_KEY=your-langwatch-api-key-here
# HIVE_ENABLE_LANGWATCH=true

# Disable Agno's telemetry ✅
AGNO_TELEMETRY=false

# ⚠️ NOT IMPLEMENTED: MCP Configuration path (not used by application)
# HIVE_MCP_CONFIG_PATH=ai/.mcp.json

# Enable AGUI mode for UI interface ✅
HIVE_ENABLE_AGUI=false

# ⚠️ NOT IMPLEMENTED: Development mode flag
# HIVE_DEV_MODE=true

# =========================================================================
# ⚠️ PERFORMANCE, LIMITS & TUNING - NOT IMPLEMENTED
# =========================================================================
#
# All settings in this section are placeholders for future implementation.
# See Issue #120 for implementation roadmap.
#
# -------------------------------------------------------------------------

# ⚠️ NOT IMPLEMENTED: Knowledge & Memory limits
# HIVE_MAX_KNOWLEDGE_RESULTS=10
# HIVE_MEMORY_RETENTION_DAYS=30
# HIVE_MAX_MEMORY_ENTRIES=1000

# ⚠️ NOT IMPLEMENTED: Caching
# HIVE_CACHE_TTL=300
# HIVE_CACHE_MAX_SIZE=1000

# ⚠️ NOT IMPLEMENTED: Rate Limiting & Session Management
# HIVE_RATE_LIMIT_REQUESTS=100
# HIVE_RATE_LIMIT_PERIOD=60
# HIVE_MAX_REQUEST_SIZE=10485760
# HIVE_MAX_CONVERSATION_TURNS=20
# HIVE_SESSION_TIMEOUT=1800
# HIVE_MAX_CONCURRENT_USERS=100

# ⚠️ NOT IMPLEMENTED: Agent & Team Routing limits
# HIVE_TEAM_ROUTING_TIMEOUT=30
# HIVE_MAX_TEAM_SWITCHES=3

# =========================================================================
# ⚠️ METRICS & MONITORING - NOT IMPLEMENTED
# =========================================================================
#
# Metrics system was removed in "Hive Obliteration" refactor.
# All variables in this section are placeholders for future implementation.
# See Issue #120 for implementation roadmap.
#
# -------------------------------------------------------------------------

# ⚠️ NOT IMPLEMENTED: All metrics collection features
# HIVE_ENABLE_METRICS=true
# HIVE_METRICS_COLLECT_TOKENS=true
# HIVE_METRICS_COLLECT_TIME=true
# HIVE_METRICS_COLLECT_TOOLS=true
# HIVE_METRICS_COLLECT_EVENTS=true
# HIVE_METRICS_COLLECT_CONTENT=true
# HIVE_METRICS_BATCH_SIZE=50
# HIVE_METRICS_FLUSH_INTERVAL=5.0
# HIVE_METRICS_QUEUE_SIZE=1000
