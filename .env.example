# =========================================================================
# ⚡ AUTOMAGIK HIVE - ENVIRONMENT CONFIGURATION
# =========================================================================
#
# Copy to .env and fill in your values.
# DO NOT commit .env to version control.
#
# =========================================================================

# -------------------------------------------------------------------------
# CORE APPLICATION
# -------------------------------------------------------------------------
# Environment: development, staging, production
HIVE_ENVIRONMENT=development

# Server port (CLI reads this directly)
HIVE_API_PORT=8886

# -------------------------------------------------------------------------
# DATABASE
# -------------------------------------------------------------------------
# Backend type: sqlite or postgresql (used by Makefile targets)
HIVE_DATABASE_BACKEND=sqlite

# Connection URL for local development
# SQLite (development/testing only - no session persistence):
HIVE_DATABASE_URL=sqlite:///./data/automagik_hive.db

# PostgreSQL (production - requires Docker):
# HIVE_DATABASE_URL=postgresql+psycopg://hive_user:your-secure-password-here@localhost:5532/hive

# -------------------------------------------------------------------------
# AI PROVIDER API KEYS (at least one required)
# -------------------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
COHERE_API_KEY=your-cohere-api-key-here

# -------------------------------------------------------------------------
# API & SECURITY
# -------------------------------------------------------------------------
# Allowed CORS origins (comma-separated)
HIVE_CORS_ORIGINS=http://localhost:3000,http://localhost:8886

# -------------------------------------------------------------------------
# OPTIONAL FEATURES
# -------------------------------------------------------------------------
# Enable AGUI web interface (requires ag-ui package)
HIVE_ENABLE_AGUI=false

# Disable Agno's telemetry
AGNO_TELEMETRY=false
